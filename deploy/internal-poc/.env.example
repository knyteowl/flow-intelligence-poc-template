# Copy to deploy/internal-poc/.env and edit.
# deploy/internal-poc/bootstrap.sh will generate passwords if .env is missing.

# Server exposure
GRAFANA_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3001
NETFLOW_LISTEN_PORT=2056
KAFKA_EXTERNAL_HOST=127.0.0.1
KAFKA_LOG_RETENTION_HOURS=24

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ClickHouse application users created by bootstrap.sh
CLICKHOUSE_GRAFANA_PASSWORD=change-me

# Optional UniFi inventory sync. Leave blank if not used in enterprise MVP.
UNIFI_API_KEY=
UNIFI_BASE_URL=https://unifi.ui.com
UNIFI_SITE_ID=
UNIFI_VERIFY_TLS=true
