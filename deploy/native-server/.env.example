# Copy to deploy/native-server/.env and edit if needed.
# deploy/native-server/bootstrap.sh generates passwords when .env is missing.

# Network/listeners
GOFLOW2_PORT=2056
GRAFANA_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3001
KAFKA_BROKER=127.0.0.1:9092
CLICKHOUSE_NATIVE_HOST=127.0.0.1
CLICKHOUSE_NATIVE_PORT=9000

# Versions
KAFKA_VERSION=3.9.0
KAFKA_SCALA_VERSION=2.13
KAFKA_HOME=/opt/kafka
FLOW_HOME=/opt/flow-poc

# Optional: set if automatic goflow2 GitHub release detection fails or internet access is restricted.
GOFLOW2_URL=

# Grafana / ClickHouse users
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
CLICKHOUSE_GRAFANA_PASSWORD=change-me

# Optional UniFi inventory sync. Leave blank if not used in enterprise MVP.
UNIFI_API_KEY=
UNIFI_BASE_URL=https://unifi.ui.com
UNIFI_SITE_ID=
UNIFI_VERIFY_TLS=true
