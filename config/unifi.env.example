# Example UniFi environment file for /opt/flow-poc/secrets/unifi.env
# Keep the real file root-only: chmod 600 /opt/flow-poc/secrets/unifi.env

# Required
UNIFI_API_KEY=

# For local/network integration API, use a base similar to:
# UNIFI_API_BASE=https://<console-host-or-ip>/proxy/network/integration
# For UniFi Site Manager API, use:
# UNIFI_API_BASE=https://api.ui.com
UNIFI_API_BASE=https://api.ui.com
UNIFI_API_VERSION=v1

# Set false only for trusted local/self-signed controller endpoints.
UNIFI_VERIFY_SSL=true

# ClickHouse container/database defaults used by scripts.
CLICKHOUSE_CONTAINER=clickhouse
CLICKHOUSE_DB=flow_poc
