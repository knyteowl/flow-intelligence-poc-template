      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-flow-poc"
          },
          "format": 2,
          "queryType": "sql",
          "rawSql": "SELECT direction, round(100 * total_bytes / sum(total_bytes) OVER (), 1) AS share_percent\nFROM\n(\n  SELECT direction, sum(bytes) AS total_bytes\n  FROM\n  (\n    SELECT multiIf(\n      (startsWith(src_addr,'10.') OR startsWith(src_addr,'192.168.') OR match(src_addr,'^172\\.(1[6-9]|2[0-9]|3[0-1])\\.')) AND NOT (startsWith(dst_addr,'10.') OR startsWith(dst_addr,'192.168.') OR match(dst_addr,'^172\\.(1[6-9]|2[0-9]|3[0-1])\\.')), 'OUTBOUND',\n      NOT (startsWith(src_addr,'10.') OR startsWith(src_addr,'192.168.') OR match(src_addr,'^172\\.(1[6-9]|2[0-9]|3[0-1])\\.')) AND (startsWith(dst_addr,'10.') OR startsWith(dst_addr,'192.168.') OR match(dst_addr,'^172\\.(1[6-9]|2[0-9]|3[0-1])\\.')), 'INBOUND',\n      (startsWith(src_addr,'10.') OR startsWith(src_addr,'192.168.') OR match(src_addr,'^172\\.(1[6-9]|2[0-9]|3[0-1])\\.')) AND (startsWith(dst_addr,'10.') OR startsWith(dst_addr,'192.168.') OR match(dst_addr,'^172\\.(1[6-9]|2[0-9]|3[0-1])\\.')), 'INTERNAL',\n      'OTHER'\n    ) AS direction, bytes\n    FROM flow_poc.flow_rollup_5m FINAL\n    WHERE $__timeFilter(bucket_start)\n  )\n  GROUP BY direction\n)\nORDER BY share_percent DESC"
        }
      ],
      "title": "DIRECTION MIX",
      "type": "barchart",
      "description": "Directional traffic share from flow_rollup_5m. Uses source/destination private-address classification, so operators can quickly see inbound, outbound, or internal dominance."
    },
