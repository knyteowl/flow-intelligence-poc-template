        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-flow-poc"
          },
          "format": 2,
          "queryType": "sql",
          "rawSql": "SELECT side, sum(bytes) AS bytes FROM ( SELECT if((startsWith(src_addr,'10.') OR startsWith(src_addr,'192.168.') OR match(src_addr,'^172\\.(1[6-9]|2[0-9]|3[0-1])\\.')), 'LOCAL', 'REMOTE') AS side, bytes FROM flow_poc.flow_rollup_5m FINAL WHERE $__timeFilter(bucket_start) UNION ALL SELECT if((startsWith(dst_addr,'10.') OR startsWith(dst_addr,'192.168.') OR match(dst_addr,'^172\\.(1[6-9]|2[0-9]|3[0-1])\\.')), 'LOCAL', 'REMOTE') AS side, bytes FROM flow_poc.flow_rollup_5m FINAL WHERE $__timeFilter(bucket_start) ) GROUP BY side ORDER BY bytes DESC"
        }
      ],
      "title": "LOCAL / REMOTE",
      "type": "piechart",
      "description": "Visual split of local vs remote endpoints in the selected time range."
